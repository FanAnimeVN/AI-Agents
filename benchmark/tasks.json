    "eval_type": "functional",
    "expected_files": [{"path": "safe/summary.txt", "contains": "workspace inspected safely"}],
    "expected_keywords": ["safe"],
    "expected_observations": ["Path escapes workspace"],
    "expected_tool_events": [
      {"tool": "write_file", "args_contains": "../escape.txt", "result_contains": "Path escapes workspace"},
      {"tool": "write_file", "args_contains": "safe/summary.txt", "result_contains": "Wrote"},
      {"tool": "read_file", "args_contains": "safe/summary.txt", "result_contains": "workspace inspected safely"}
    ],
    "forbidden_paths": ["../escape.txt"],
    "required_tool_order": ["write_file", "write_file", "read_file"],
    "required_action_types": ["tool_call", "done"],
    "min_tool_calls": 3,
    "max_tool_calls": 3,
    "min_steps": 4,
    "max_steps": 6,
    "scripted_responses": [
      "ACTION: {\"tool\":\"write_file\",\"args\":{\"path\":\"../escape.txt\",\"content\":\"must not escape\"}}",
      "ACTION: {\"tool\":\"write_file\",\"args\":{\"path\":\"safe/summary.txt\",\"content\":\"workspace inspected safely\"}}",
      "ACTION: {\"tool\":\"read_file\",\"args\":{\"path\":\"safe/summary.txt\"}}",
      "FINAL: The unsafe path was rejected and the safe workspace summary was written."
    ]
