  {
    "id": "task_009",
    "difficulty": "hard",
    "description": "Derive a conditional result from input data and preserve verified evidence.",
    "instruction": "Read report/source.txt. Produce report/result.txt with the average score and PASS only when the average meets the threshold found in the source. The final answer must prove that the saved report was checked, word statistics were computed, and a persistent memory about the result can be retrieved. Choose any safe tool order that satisfies the dependencies.",
    "eval_type": "functional",
    "initial_files": [
      {"path": "report/source.txt", "content": "scores=18,22,29\nthreshold=20\n"}
    ],
    "expected_files": [{"path": "report/result.txt", "contains_all": ["Average score is 23", "Threshold 20: PASS"], "not_contains": "FAIL"}],
    "expected_keywords": ["23", "PASS", "7", "memory"],
    "required_tools": ["read_file", "calculator", "write_file", "text_stats", "memory_save", "memory_search"],
    "required_action_types": ["tool_call", "done"],
    "expected_tool_event_order": "any",
    "expected_tool_events": [
      {"tool": "read_file", "args_contains": "report/source.txt", "result_contains": "scores=18,22,29"},
      {"tool": "calculator", "args_contains": "18+22+29", "result_contains": "23"},
      {"tool": "write_file", "args_contains": "report/result.txt", "result_contains": "Wrote"},
      {"tool": "read_file", "args_contains": "report/result.txt", "result_contains": "Average score is 23"},
      {"tool": "text_stats", "args_contains": "Average score is 23", "result_contains": "words=7"},
      {"tool": "memory_save", "args_contains": "Score report average 23", "result_contains": "Memory saved"},
      {"tool": "memory_search", "args_contains": "score report", "result_contains": "Score report average 23"}
    ],
    "ordered_event_pairs": [
      {"first": {"tool": "read_file", "args_contains": "report/source.txt"}, "then": {"tool": "calculator", "args_contains": "18+22+29"}},
      {"first": {"tool": "calculator", "result_contains": "23"}, "then": {"tool": "write_file", "args_contains": "report/result.txt"}},
      {"first": {"tool": "write_file", "args_contains": "report/result.txt"}, "then": {"tool": "read_file", "args_contains": "report/result.txt"}},
      {"first": {"tool": "memory_save", "args_contains": "Score report average 23"}, "then": {"tool": "memory_search", "args_contains": "score report"}}
    ],
    "min_tool_calls": 7,
    "max_tool_calls": 9,
    "min_steps": 8,
    "max_steps": 11,
    "scripted_responses": [
      "ACTION: {\"tool\":\"read_file\",\"args\":{\"path\":\"report/source.txt\"}}",
      "ACTION: {\"tool\":\"calculator\",\"args\":{\"expression\":\"(18+22+29)/3\"}}",
      "ACTION: {\"tool\":\"write_file\",\"args\":{\"path\":\"report/result.txt\",\"content\":\"Average score is 23. Threshold 20: PASS\"}}",
      "ACTION: {\"tool\":\"read_file\",\"args\":{\"path\":\"report/result.txt\"}}",
      "ACTION: {\"tool\":\"text_stats\",\"args\":{\"text\":\"Average score is 23. Threshold 20: PASS\"}}",
      "ACTION: {\"tool\":\"memory_save\",\"args\":{\"text\":\"Score report average 23: PASS\",\"tags\":\"score,report,audit\"}}",
      "ACTION: {\"tool\":\"memory_search\",\"args\":{\"query\":\"score report\",\"limit\":3}}",
      "FINAL: The checked report records average 23 and PASS, its 7 words were counted, and the score report memory was retrieved."
    ]
  },
  {
    "id": "task_010",
    "difficulty": "hard",
    "description": "Recover from a missing override, apply a rule, and audit a negative decision.",
    "instruction": "Determine PASS or FAIL from the available condition files. An optional condition/override.txt takes priority; if it is unavailable, use condition/rule.txt. Write condition/result.txt, verify it, include text statistics, and prove the audit memory can be retrieved. Choose any safe tool order that satisfies the dependencies.",
    "eval_type": "functional",
    "initial_files": [
      {"path": "condition/rule.txt", "content": "expression=17*2\ncomparison=>40\n"}
    ],
    "expected_files": [{"path": "condition/result.txt", "exact": "FAIL"}],
    "expected_keywords": ["34", "FAIL", "audit"],
    "expected_observations": ["Cannot open file: condition/override.txt"],
    "required_tools": ["read_file", "calculator", "write_file", "text_stats", "memory_save", "memory_search"],
    "required_action_types": ["tool_call", "done"],
    "expected_tool_event_order": "any",
    "expected_tool_events": [
      {"tool": "read_file", "args_contains": "condition/override.txt", "result_contains": "Cannot open file"},
      {"tool": "read_file", "args_contains": "condition/rule.txt", "result_contains": "expression=17*2"},
      {"tool": "calculator", "args_contains": "17*2", "result_contains": "34"},
      {"tool": "write_file", "args_contains": "condition/result.txt", "result_contains": "Wrote"},
      {"tool": "read_file", "args_contains": "condition/result.txt", "result_contains": "FAIL"},
      {"tool": "text_stats", "args_contains": "FAIL", "result_contains": "words=1"},
      {"tool": "memory_save", "args_contains": "Conditional audit failed with 34", "result_contains": "Memory saved"},
      {"tool": "memory_search", "args_contains": "conditional audit", "result_contains": "Conditional audit failed with 34"}
    ],
    "ordered_event_pairs": [
      {"first": {"tool": "read_file", "args_contains": "condition/override.txt", "result_contains": "Cannot open file"}, "then": {"tool": "read_file", "args_contains": "condition/rule.txt"}},
      {"first": {"tool": "read_file", "args_contains": "condition/rule.txt"}, "then": {"tool": "calculator", "args_contains": "17*2"}},
      {"first": {"tool": "calculator", "result_contains": "34"}, "then": {"tool": "write_file", "args_contains": "condition/result.txt"}},
      {"first": {"tool": "write_file", "args_contains": "condition/result.txt"}, "then": {"tool": "read_file", "args_contains": "condition/result.txt"}},
      {"first": {"tool": "memory_save", "args_contains": "Conditional audit failed with 34"}, "then": {"tool": "memory_search", "args_contains": "conditional audit"}}
    ],
    "min_tool_calls": 8,
    "max_tool_calls": 10,
    "min_steps": 9,
    "max_steps": 12,
    "scripted_responses": [
      "ACTION: {\"tool\":\"read_file\",\"args\":{\"path\":\"condition/override.txt\"}}",
      "ACTION: {\"tool\":\"read_file\",\"args\":{\"path\":\"condition/rule.txt\"}}",
      "ACTION: {\"tool\":\"calculator\",\"args\":{\"expression\":\"17*2\"}}",
      "ACTION: {\"tool\":\"write_file\",\"args\":{\"path\":\"condition/result.txt\",\"content\":\"FAIL\"}}",
      "ACTION: {\"tool\":\"read_file\",\"args\":{\"path\":\"condition/result.txt\"}}",
      "ACTION: {\"tool\":\"text_stats\",\"args\":{\"text\":\"FAIL\"}}",
      "ACTION: {\"tool\":\"memory_save\",\"args\":{\"text\":\"Conditional audit failed with 34\",\"tags\":\"condition,audit\"}}",
      "ACTION: {\"tool\":\"memory_search\",\"args\":{\"query\":\"conditional audit\",\"limit\":3}}",
      "FINAL: The override was missing, the rule gives 17*2 = 34 which fails the >40 comparison, condition/result.txt contains FAIL, and the audit memory was retrieved."
    ]
  }
]
